---
/**
 * Home Page - English Version
 *
 * Landing page with design cloned from raissagr.com
 * Colors: Black, white and pink accent (#EA559D)
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { translations } from "../../i18n";

const lang = "en";
const tr = translations[lang];
const siteUrl = import.meta.env.SITE || 'https://raissagr.com';

/**
 * Artistic work features
 */
const features = [
	{ number: "01", title: tr.features.f1Title, description: tr.features.f1Desc },
	{ number: "02", title: tr.features.f2Title, description: tr.features.f2Desc },
	{ number: "03", title: tr.features.f3Title, description: tr.features.f3Desc },
	{ number: "04", title: tr.features.f4Title, description: tr.features.f4Desc },
	{ number: "05", title: tr.features.f5Title, description: tr.features.f5Desc },
];

/**
 * Testimonials
 */
const testimonials = [
	{
		quote: tr.testimonials.t1Quote,
		author: tr.testimonials.t1Author,
		image: "/images/testimonial-01.jpg",
	},
	{
		quote: tr.testimonials.t2Quote,
		author: tr.testimonials.t2Author,
		image: "/images/testimonial-02.jpg",
	},
];
---

<BaseLayout 
  title="raissagr | Visual Artist" 
  description="Art from emotion and matter. Portfolio of Raissa García, visual artist in Altea, Spain."
  alternateUrl={siteUrl}
  keywords="Raissa García, visual artist, contemporary art, painting, Altea, Spain, oil, acrylic, mixed media"
>
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center relative overflow-hidden">
    <div class="absolute inset-0">
      <img 
        src="/images/hero-artwork-full.jpg" 
        alt="Artwork by Raissa García" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white via-white/90 to-transparent"></div>
    </div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-2xl">
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-serif text-neutral-900 tracking-tighter mb-6 animate-fade-up">
          raissagr
        </h1>
        
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-neutral-700 mb-6 animate-fade-up delay-100">
          {tr.home.subtitle}
        </h2>
        
        <p class="text-lg text-neutral-600 max-w-xl mb-10 animate-fade-up delay-200 leading-relaxed">
          {tr.home.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 animate-fade-up delay-300">
          <a href="/en/work" class="btn-primary">
            {tr.home.verObra}
          </a>
          <a href="/en/contact" class="btn-outline">
            {tr.home.contactar}
          </a>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <a href="#propuesta" class="block text-neutral-400 hover:text-[#EA559D] transition-colors" aria-label="Scroll to see more">
        <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>
  
  <!-- Value Proposition -->
  <section id="propuesta" class="py-12 md:py-16 bg-[#FAD8E9]/30">
    <div class="container-custom">
      <div class="text-center mb-16">
        <p class="subtitle text-[#EA559D]">{tr.home.miTrabajo}</p>
        <h2 class="text-neutral-900">{tr.home.ventanaTrabajo}</h2>
        <p class="lead mt-4 max-w-2xl mx-auto">
          {tr.home.coleccionCuadros}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
        {features.map((feature, index) => (
          <div class="feature-card" style={`animation-delay: ${index * 100}ms`}>
            <span class="feature-number text-[#FAD8E9]">{feature.number}</span>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="subtitle text-[#EA559D]">{tr.home.sobreMi}</p>
          <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-neutral-800 leading-relaxed mb-8">
            {tr.home.sobreMiIntro}
          </p>
          <p class="text-lg text-neutral-600 mb-6 leading-relaxed">
            {tr.home.trabajoNace}
          </p>
          <p class="text-lg text-neutral-600 mb-8 leading-relaxed">
            {tr.home.pintoParaEntender}
          </p>
          
          <p class="font-serif text-xl text-[#EA559D] italic mb-8">
            {tr.home.bienvenido}
          </p>
          
          <a href="/en/about" class="btn-link">
            {tr.home.conocerMas}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        
        <div class="relative">
          <img 
            src="/images/raissa-garcia.jpg" 
            alt="Raissa García - Visual Artist" 
            class="w-full aspect-[4/5] object-cover"
          />
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-[#EA559D] -z-10"></div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Gallery Preview -->
  <section class="py-12 md:py-16 bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <p class="subtitle text-[#EA559D]">{tr.home.portafolio}</p>
        <h2 class="text-neutral-900">{tr.home.obraReciente}</h2>
      </div>
      
      <div class="gallery-grid">
        <div class="gallery-item">
          <img 
            src="/images/hero-artwork-full.jpg" 
            alt="Artwork by Raissa García" 
            class="w-full h-full object-cover"
          />
        </div>
        {[2, 3, 4, 5, 6].map((item) => (
          <div class="gallery-item bg-neutral-100">
            <div class="w-full h-full flex items-center justify-center text-neutral-300">
              <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/en/work" class="btn-primary">
          {tr.home.verTodaObra}
        </a>
      </div>
    </div>
  </section>
  
  <!-- Testimonials -->
  <section class="py-12 md:py-16 bg-[#FAD8E9]/20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <p class="subtitle text-[#EA559D]">{tr.home.testimonios}</p>
        <h2 class="text-neutral-900">{tr.home.vocesAcompanan}</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.map((testimonial) => (
          <div class="bg-white p-8 md:p-12 shadow-sm">
            <blockquote class="testimonial-quote text-neutral-800">
              "{testimonial.quote}"
            </blockquote>
            <div class="flex items-center gap-4 mt-6">
              <img 
                src={testimonial.image} 
                alt={testimonial.author}
                class="w-12 h-12 rounded-full object-cover"
              />
              <cite class="text-sm font-medium text-neutral-600 not-italic">
                {testimonial.author}
              </cite>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Final CTA -->
  <section class="py-12 md:py-16 bg-[#EA559D] text-white">
    <div class="container-custom text-center">
      <h2 class="text-white mb-4">{tr.home.conectemos}</h2>
      <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
        {tr.home.estariaEncantada}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/en/work" class="btn bg-white text-[#EA559D] hover:bg-neutral-100">
          {tr.home.verTodaObra}
        </a>
        <a href="/en/contact" class="btn border border-white/50 text-white hover:bg-white/10">
          {tr.home.escribeme}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .animate-fade-up {
    opacity: 0;
    animation: fade-up 0.8s ease-out forwards;
  }
  
  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
