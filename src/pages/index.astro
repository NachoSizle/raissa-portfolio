---
/**
 * Página Principal
 *
 * Landing page con diseño clonado de raissagr.com
 * Colores: Negro, blanco y acento rosa (#EA559D)
 */
import BaseLayout from "../layouts/BaseLayout.astro";

const siteUrl = import.meta.env.SITE || "https://raissagr.com";

/**
 * Características del trabajo artístico
 * Secciones numeradas de raissagr.com
 */
const features = [
	{
		number: "01",
		title: "Lenguaje visual introspectivo",
		description:
			"La obra parte de la emoción y se construye desde el gesto, la memoria y lo sensorial.",
	},
	{
		number: "02",
		title: "Exploración material constante",
		description:
			"Trabajo con técnicas mixtas, madera, óleo, acrílico y escultura desde un enfoque experimental.",
	},
	{
		number: "03",
		title: "Producción honesta y libre",
		description:
			"Solo hay pulsos visuales abiertos a la interpretación del espectador.",
	},
	{
		number: "04",
		title: "Obra entre lo íntimo y lo colectivo",
		description:
			"Cada pieza contiene fragmentos de identidad que buscan resonar más allá de lo personal.",
	},
	{
		number: "05",
		title: "Trayectoria emergente sólida",
		description:
			"Con exposiciones en espacios como el MUA de Alicante y Palau Altea, mi obra crece con coherencia conceptual y material.",
	},
];

/**
 * Testimonios - "Voces que acompañan mi obra"
 */
const testimonials = [
	{
		quote:
			"Sus piezas tienen una fuerza silenciosa que te atrapa. No buscan explicarse, sino sentirse, y transforma por completo la energía del lugar.",
		author: "Coleccionista privado",
		image: "/images/testimonial-01.jpg",
	},
	{
		quote:
			"Las obras de Raissa transmiten una sensibilidad única; cada pieza invita a detenerse y sentir.",
		author: "@albittfckb_",
		image: "/images/testimonial-02.jpg",
	},
];
---

<BaseLayout 
  title="raissagr | Artista Visual" 
  description="Arte desde la emoción y la materia. Portafolio de Raissa García, artista visual en Altea, España."
  alternateUrl={`${siteUrl}/en`}
  keywords="Raissa García, artista visual, arte contemporáneo, pintura, Altea, España, óleo, acrílico, técnica mixta"
>
  <!-- Hero Section con imagen -->
  <section class="min-h-screen flex items-center relative overflow-hidden">
    <!-- Imagen de fondo -->
    <div class="absolute inset-0">
      <img 
        src="/images/hero-artwork-full.jpg" 
        alt="Obra de Raissa García - Arte contemporáneo" 
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white via-white/90 to-transparent"></div>
    </div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-2xl">
        <!-- Logo/Nombre grande -->
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-serif text-neutral-900 tracking-tighter mb-6 animate-fade-up">
          raissagr
        </h1>
        
        <!-- Subtítulo principal -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-neutral-700 mb-6 animate-fade-up delay-100">
          Arte desde la emoción y la materia
        </h2>
        
        <!-- Descripción -->
        <p class="text-lg text-neutral-600 max-w-xl mb-10 animate-fade-up delay-200 leading-relaxed">
          En esta web encontrarás obras originales, proyectos personalizados y una práctica artística 
          en constante investigación, pensada para quienes buscan piezas que resuenen más allá de la forma.
        </p>
        
        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 animate-fade-up delay-300">
          <a href="/obra" class="btn-primary">
            Ver Obra
          </a>
          <a href="/contacto" class="btn-outline">
            Contactar
          </a>
        </div>
      </div>
    </div>
    
    <!-- Indicador de scroll -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <a href="#propuesta" class="block text-neutral-400 hover:text-[#EA559D] transition-colors" aria-label="Scroll para ver más">
        <svg class="w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>
  
  <!-- Propuesta de Valor - Sección numerada -->
  <section id="propuesta" class="py-12 md:py-16 bg-[#FAD8E9]/30">
    <div class="container-custom">
      <div class="text-center mb-16">
        <p class="subtitle text-[#EA559D]">Mi trabajo</p>
        <h2 class="text-neutral-900">Este sitio es una ventana a mi trabajo</h2>
        <p class="lead mt-4 max-w-2xl mx-auto">
          Una colección de cuadros que abarcan diferentes etapas y estilos.
        </p>
      </div>
      
      <!-- Grid de características -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
        {features.map((feature, index) => (
          <div class="feature-card" style={`animation-delay: ${index * 100}ms`}>
            <span class="feature-number text-[#FAD8E9]">{feature.number}</span>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Introducción personal con imagen -->
  <section class="py-12 md:py-16">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Texto -->
        <div>
          <p class="subtitle text-[#EA559D]">Sobre mí</p>
          <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-neutral-800 leading-relaxed mb-8">
            Soy Raissa, artista visual apasionada por explorar la mente, la identidad 
            y todo aquello que se mueve entre lo tangible y lo emocional.
          </p>
          <p class="text-lg text-neutral-600 mb-6 leading-relaxed">
            Mi trabajo nace de la experimentación constante y del impulso por transformar 
            sensaciones en obras que conecten con quien las mira.
          </p>
          <p class="text-lg text-neutral-600 mb-8 leading-relaxed">
            Pinto para entender, para sentir y para generar un diálogo sincero 
            a través del color, el símbolo y la intuición.
          </p>
          
          <p class="font-serif text-xl text-[#EA559D] italic mb-8">
            Bienvenido a mi espacio creativo.
          </p>
          
          <a href="/sobre-mi" class="btn-link">
            Conocer más
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        
        <!-- Imagen de Raissa -->
        <div class="relative">
          <img 
            src="/images/raissa-garcia.jpg" 
            alt="Raissa García - Artista Visual" 
            class="w-full aspect-[4/5] object-cover"
          />
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-[#EA559D] -z-10"></div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Galería preview -->
  <section class="py-12 md:py-16 bg-white">
    <div class="container-wide">
      <div class="text-center mb-12">
        <p class="subtitle text-[#EA559D]">Portafolio</p>
        <h2 class="text-neutral-900">Obra reciente</h2>
      </div>
      
      <!-- Grid de galería con imagen real -->
      <div class="gallery-grid">
        <div class="gallery-item">
          <img 
            src="/images/hero-artwork-full.jpg" 
            alt="Obra de Raissa García" 
            class="w-full h-full object-cover"
          />
        </div>
        {[2, 3, 4, 5, 6].map((item) => (
          <div class="gallery-item bg-neutral-100">
            <div class="w-full h-full flex items-center justify-center text-neutral-300">
              <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/obra" class="btn-primary">
          Ver toda la obra
        </a>
      </div>
    </div>
  </section>
  
  <!-- Testimonios -->
  <section class="py-12 md:py-16 bg-[#FAD8E9]/20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <p class="subtitle text-[#EA559D]">Testimonios</p>
        <h2 class="text-neutral-900">Voces que acompañan mi obra</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {testimonials.map((testimonial) => (
          <div class="bg-white p-8 md:p-12 shadow-sm">
            <blockquote class="testimonial-quote text-neutral-800">
              "{testimonial.quote}"
            </blockquote>
            <div class="flex items-center gap-4 mt-6">
              <img 
                src={testimonial.image} 
                alt={testimonial.author}
                class="w-12 h-12 rounded-full object-cover"
              />
              <cite class="text-sm font-medium text-neutral-600 not-italic">
                {testimonial.author}
              </cite>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA Final con acento rosa -->
  <section class="py-12 md:py-16 bg-[#EA559D] text-white">
    <div class="container-custom text-center">
      <h2 class="text-white mb-4">¿Te gustaría adquirir una obra?</h2>
      <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
        Podrás descubrir las colecciones, adquirir obra y conocer servicios 
        como proyectos a medida o colaboraciones artísticas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/obra" class="btn bg-white text-[#EA559D] hover:bg-neutral-100">
          Ver colecciones
        </a>
        <a href="/contacto" class="btn border border-white/50 text-white hover:bg-white/10">
          Contactar
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Animaciones específicas de la página */
  .animate-fade-up {
    opacity: 0;
    animation: fade-up 0.8s ease-out forwards;
  }
  
  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
  
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
