---
import { getLangFromUrl, translations } from "../i18n";
import LanguageSelector from "./LanguageSelector.astro";
import { url, getBase } from "../utils/paths";

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const tr = translations[lang];
const base = getBase();

/**
 * Enlaces de navegación según el idioma
 */
const navLinks =
	lang === "es"
		? [
				{ href: url("obra"), label: tr.nav.obra },
				{ href: url("sobre-mi"), label: tr.nav.sobreMi },
				{ href: url("contacto"), label: tr.nav.contacto },
			]
		: [
				{ href: url("en/work"), label: tr.nav.obra },
				{ href: url("en/about"), label: tr.nav.sobreMi },
				{ href: url("en/contact"), label: tr.nav.contacto },
			];

const homeLink = lang === "es" ? base : url("en");

/**
 * Determina si un enlace está activo
 * @param href - La ruta del enlace
 * @returns boolean
 */
function isActive(href: string): boolean {
	if (href === base || href === url("en")) {
		return currentPath === base || currentPath === url("en") || currentPath === `${url("en")}/`;
	}
	return currentPath.startsWith(href);
}
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm">
  <nav class="container-custom">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a 
        href={homeLink}
        class="font-serif text-2xl md:text-3xl text-neutral-900 hover:text-neutral-600 transition-colors tracking-tight"
        aria-label={lang === 'es' ? 'Ir al inicio' : 'Go to home'}
      >
        raissagr
      </a>
      
      <!-- Navegación Desktop + Selector Idioma -->
      <div class="hidden md:flex items-center gap-10">
        <ul class="flex items-center gap-10">
          {navLinks.map((link) => (
            <li>
              <a 
                href={link.href}
                class:list={[
                  'nav-link',
                  { 'active': isActive(link.href) }
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        
        <!-- Separador -->
        <div class="w-px h-5 bg-neutral-300"></div>
        
        <!-- Selector de idioma -->
        <LanguageSelector />
      </div>
      
      <!-- Botón Menú Móvil -->
      <div class="flex items-center gap-4 md:hidden">
        <!-- Selector de idioma móvil -->
        <LanguageSelector />
        
        <button 
          type="button"
          class="p-2 -mr-2 text-neutral-900 hover:text-neutral-600 transition-colors"
          aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-button"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="1.5" 
              d="M4 6h16M4 12h16M4 18h16"
              class="menu-icon"
            />
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="1.5" 
              d="M6 18L18 6M6 6l12 12"
              class="close-icon hidden"
            />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Menú Móvil -->
    <div 
      id="mobile-menu" 
      class="md:hidden hidden border-t border-neutral-100"
      aria-labelledby="mobile-menu-button"
    >
      <ul class="py-6 space-y-1">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href}
              class:list={[
                'block py-4 text-lg font-serif transition-colors',
                isActive(link.href) 
                  ? 'text-neutral-900' 
                  : 'text-neutral-500 hover:text-neutral-900'
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<!-- Espaciador para contenido bajo header fijo -->
<div class="h-20 md:h-24" aria-hidden="true"></div>

<script>
  /**
   * Script para el menú móvil
   * Maneja la apertura/cierre del menú en dispositivos móviles
   */
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = menuButton?.querySelector('.menu-icon');
  const closeIcon = menuButton?.querySelector('.close-icon');
  
  menuButton?.addEventListener('click', () => {
    const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
    
    menuButton.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
  
  // Cerrar menú al hacer clic en un enlace
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
