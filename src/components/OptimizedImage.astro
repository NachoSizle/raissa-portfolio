---
/**
 * Componente OptimizedImage
 *
 * Imagen optimizada con lazy loading nativo, placeholder blur,
 * y soporte para formatos modernos (WebP, AVIF).
 *
 * @param {string} src - Ruta de la imagen
 * @param {string} alt - Texto alternativo (obligatorio para SEO)
 * @param {string} class - Clases CSS adicionales
 * @param {string} loading - Estrategia de carga ('lazy' | 'eager')
 * @param {string} decoding - Decodificación ('async' | 'sync' | 'auto')
 * @param {number} width - Ancho de la imagen
 * @param {number} height - Alto de la imagen
 * @param {boolean} priority - Si es true, precarga la imagen (para LCP)
 */
interface Props {
	src: string;
	alt: string;
	class?: string;
	loading?: "lazy" | "eager";
	decoding?: "async" | "sync" | "auto";
	width?: number;
	height?: number;
	priority?: boolean;
	sizes?: string;
}

const {
	src,
	alt,
	class: className = "",
	loading = "lazy",
	decoding = "async",
	width,
	height,
	priority = false,
	sizes = "100vw",
} = Astro.props;

// Si es priority, usar eager loading
const actualLoading = priority ? "eager" : loading;
const fetchPriority = priority ? "high" : "auto";
---

{priority && (
  <link rel="preload" as="image" href={src} />
)}

<img
  src={src}
  alt={alt}
  class={className}
  loading={actualLoading}
  decoding={decoding}
  width={width}
  height={height}
  sizes={sizes}
  fetchpriority={fetchPriority}
/>
